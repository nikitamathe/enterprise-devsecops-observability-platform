apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: banking

resources:
  - namespace.yaml
  - mysql-secret.yaml
  - mysql-statefulset.yaml
  - account-deployment.yaml
  - auth-deployment.yaml
  - transaction-deployment.yaml
  - notification-deployment.yaml
  - api-gateway-deployment.yaml
  - frontend-deployment.yaml

images:
  - name: nikitamathe/account-service
    newTag: latest
  - name: nikitamathe/auth-service
    newTag: latest
  - name: nikitamathe/transaction-service
    newTag: latest
  - name: nikitamathe/notification-service
    newTag: latest
  - name: nikitamathe/api-gateway
    newTag: latest
  - name: nikitamathe/frontend
    newTag: latest